# core-adapters - Doxygen configuration (configured by CMakeLists.txt; build: make docs).
# Every public entity is documented; warnings are errors (CLAUDE.md "Documentation"). The aliases are core's, so a
# header documented to core's standard needs no rewrite here.
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "core-adapters"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Third-party adapters for snicholls-core: nanobind helpers, nlohmann/json hooks, the snicholls_core Python package"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/README.md \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs \
                         @CMAKE_CURRENT_SOURCE_DIR@/include
FILE_PATTERNS          = *.hpp *.md *.dox
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/README.md
EXAMPLE_PATH           = @CMAKE_CURRENT_SOURCE_DIR@/demos
EXAMPLE_RECURSIVE      = YES
STRIP_FROM_PATH        = @CMAKE_CURRENT_SOURCE_DIR@/include
STRIP_FROM_INC_PATH    = @CMAKE_CURRENT_SOURCE_DIR@/include
FULL_PATH_NAMES        = YES
ALIASES                = "overview=\par Overview^^" \
                         "relations=\par Relationships^^" \
                         "impls=\par Implementations and variants^^" \
                         "contracts=\par Guarantees and contracts^^" \
                         "errors=\par Errors^^" \
                         "examples=\par Examples^^" \
                         "perf=\par Performance^^" \
                         "testing=\par Tests and demos^^" \
                         "deps=\par Dependencies^^" \
                         "gotchas=\par Known issues and gotchas^^" \
                         "status=\par Status^^" \
                         "python{1}=\par Python^^ <tt>\1</tt>"
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
EXCLUDE_SYMBOLS        = snicholls::detail snicholls::detail::* *::detail *::detail::* nanobind::detail nanobind::detail::*
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
HAVE_DOT               = NO
MACRO_EXPANSION        = NO
PREDEFINED             = SNICHOLLS_DOXYGEN
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = YES
